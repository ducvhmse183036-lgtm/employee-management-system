# Copy to .env.production.local after the real HTTPS backend is available.
# Use an origin only (no /api suffix). VITE_* variables are public build settings.
VITE_API_BASE_URL=https://YOUR-BACKEND-DOMAIN.example.com

# Development: leave VITE_API_BASE_URL unset/empty to use the Vite proxy.
# VITE_API_BASE_URL=

# Local web development (.env.development):
# VITE_API_BASE_URL=http://localhost:8080
# Local Capacitor development (.env.mobile, selected by --mode mobile):
# VITE_API_BASE_URL=http://192.168.1.190:8080
# Optional personal overrides: .env.development.local or .env.mobile.local.
